---
import { TIPS, getTipOfTheDay } from "../data/tips";

const tipOfDay = getTipOfTheDay();
const more = TIPS.filter((t) => t !== tipOfDay).slice(0, 6);
---

<section class="tips">
  <h2 class="section-title reveal">// tips_of_the_trade</h2>

  <article class="tip-hero reveal">
    <span class="badge badge-tutorials">💡 Tip of the day</span>
    <h3>{tipOfDay.icon} {tipOfDay.title}</h3>
    <p>{tipOfDay.text}</p>
  </article>

  <div class="grid">
    {
      more.map((tip, i) => (
        <article
          class="tip-card reveal"
          style={`--reveal-delay:${Math.min((i + 1) * 90, 450)}ms`}
        >
          <div class="head">
            <span>{tip.icon} {tip.title}</span>
            <span class="tag">#{tip.tag}</span>
          </div>
          <p>{tip.text}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .tips {
    margin-top: 4rem;
  }

  .section-title {
    font-size: 1.7rem;
    margin-bottom: 1.5rem;
    font-family: var(--font-mono);
    color: var(--accent);
  }

  .tip-hero {
    background:
      radial-gradient(
        ellipse at top left,
        rgb(0 255 65 / 8%),
        transparent 60%
      ),
      var(--bg-card);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: var(--radius);
    padding: 1.5rem 1.75rem;
    margin-bottom: 1.25rem;
    box-shadow: 0 0 24px rgb(0 255 65 / 8%);
  }

  .tip-hero h3 {
    font-size: 1.3rem;
    margin: 0.9rem 0 0.4rem;
  }

  .tip-hero p {
    color: var(--text-muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  .grid > .reveal {
    height: 100%;
  }

  .tip-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.15rem 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    transition:
      border-color 0.3s ease,
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .tip-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 0 18px rgb(0 255 65 / 10%);
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 400;
    color: var(--accent-hover);
    white-space: nowrap;
  }

  .tip-card p {
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.55;
  }
</style>

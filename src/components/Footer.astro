---
import { SITE_TITLE, SITE_DESCRIPTION, CATEGORIES } from "../consts";
import { withBase } from "../utils";

const year = new Date().getFullYear();
---

<footer>
  <div class="container">
    <div class="col brand">
      <p class="name">{SITE_TITLE}</p>
      <p class="desc">{SITE_DESCRIPTION}</p>
    </div>
    <nav class="col" aria-label="Categories">
      <p class="heading">Categories</p>
      {
        Object.entries(CATEGORIES).map(([key, meta]) => (
          <a href={withBase(`/categories/${key}/`)}>{meta.name}</a>
        ))
      }
    </nav>
    <div class="col">
      <p class="heading">Resources</p>
      <a href={withBase("/rss.xml")}>RSS Feed</a>
      <a href={withBase("/sitemap-index.xml")}>Sitemap</a>
    </div>
    <div class="col">
      <p class="heading">Connect</p>
      <a
        href="https://github.com/melak-cmd/kaonix-blog"
        target="_blank"
        rel="noopener noreferrer">GitHub</a
      >
      <a href="#" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href="#" target="_blank" rel="noopener noreferrer">Support ☕</a>
    </div>
  </div>
  <div class="legal">
    © {year} {SITE_TITLE}. All rights reserved.
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    padding: 3rem 1.5rem 1.5rem;
    margin-top: auto;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 2.5rem;
  }

  .brand .name {
    font-weight: 700;
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .brand .desc,
  .heading {
    color: var(--text-muted);
  }

  .brand .desc {
    font-size: 0.9rem;
    max-width: 320px;
    line-height: 1.6;
  }

  .heading {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  nav.col,
  .col:last-child {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  footer a {
    color: var(--text-muted);
    font-size: 0.92rem;
    width: fit-content;
  }

  footer a:hover {
    color: var(--text);
  }

  .legal {
    max-width: 1100px;
    margin: 2.5rem auto 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.85rem;
    text-align: center;
  }

  @media (max-width: 640px) {
    .container {
      grid-template-columns: 1fr;
      gap: 1.8rem;
    }
  }
</style>

---
import { withBase } from "../utils";
import type { TagStat } from "../utils";

interface Props {
  tags: TagStat[];
}

const { tags } = Astro.props;

const max = Math.max(...tags.map((t) => t.count), 1);
const min = Math.min(...tags.map((t) => t.count), 1);
const weight = (count: number) => (count - min) / Math.max(max - min, 1);
const fontSize = (count: number) =>
  0.9 + weight(count) * 0.7;
---

{
  tags.length > 0 ? (
    <ul class="tag-cloud">
      {tags.map((tag) => (
        <li>
          <a
            href={withBase(`/tags/${tag.slug}/`)}
            style={`font-size:${fontSize(tag.count).toFixed(2)}rem;--weight:${weight(tag.count).toFixed(2)}`}
            title={`${tag.count} ${tag.count === 1 ? "article" : "articles"}`}
          >
            {tag.name}
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="empty">No technologies tagged yet.</p>
  )
}

<style>
  .tag-cloud {
    list-style: none;
    padding: 1.5rem;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.6rem 1.4rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .tag-cloud a {
    font-family: var(--font-mono, monospace);
    font-weight: 600;
    line-height: 1;
    color: var(--accent-hover);
    opacity: calc(0.55 + (var(--weight, 1) * 0.45));
    transition:
      color 0.15s ease,
      text-shadow 0.15s ease;
  }

  .tag-cloud a:hover {
    color: var(--accent);
    text-shadow: 0 0 12px var(--accent);
    text-decoration: none;
  }

  .empty {
    color: var(--text-muted);
    text-align: center;
    padding: 3rem 0;
  }
</style>

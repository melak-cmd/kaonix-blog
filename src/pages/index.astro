---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import MatrixRain from "../components/MatrixRain.astro";
import { SITE_TITLE, SITE_DESCRIPTION, CATEGORIES } from "../consts";
import { withBase } from "../utils";
import { getReadingTime } from "../utils";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const totalMinutes = allPosts.reduce(
  (sum, p) => sum + getReadingTime(p.body ?? ""),
  0,
);
const stats = [
  { value: `${allPosts.length}`, label: "articles" },
  { value: `${Math.round(totalMinutes / 6) / 10}h`, label: "of reading" },
  { value: `${Object.keys(CATEGORIES).length}`, label: "categories" },
];

const startHere = [
  {
    icon: "🌱",
    who: "Starting from zero?",
    text: "Containers are the backbone of modern infrastructure — begin with Docker, no experience needed.",
    href: withBase("/blog/tutorials/getting-started-with-docker/"),
    cta: "Learn Docker basics",
  },
  {
    icon: "🚀",
    who: "Ready to level up?",
    text: "Clean Git history, strict TypeScript and solid APIs — the habits that separate juniors from seniors.",
    href: withBase("/categories/best-practices/"),
    cta: "Browse best practices",
  },
  {
    icon: "📰",
    who: "Short on time?",
    text: "Catch up on what's shaping the industry — tooling, AI and platform engineering news worth your attention.",
    href: withBase("/categories/news/"),
    cta: "Read tech news",
  },
];
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="hero-banner">
    <MatrixRain />
    <div class="scanlines" aria-hidden="true"></div>
    <div class="hero-content">
      <p class="kicker">$ ./welcome --to kaonix<span class="caret">▊</span></p>
      <h1>{SITE_TITLE}</h1>
      <p class="tagline">
        Practical IT tutorials, battle-tested best practices, and the latest
        news in technology — follow the white rabbit.
      </p>
      <div class="cta">
        <a class="btn" href={withBase("/blog/")}>Read the Blog</a>
        <a class="link-alt" href={withBase("/categories/")}>Browse Categories →</a>
      </div>
    </div>
  </section>

  <section class="stats-bar reveal" aria-label="Site statistics">
    {
      stats.map((s) => (
        <div class="stat">
          <span class="value">{s.value}</span>
          <span class="label">{s.label}</span>
        </div>
      ))
    }
  </section>

  <section class="start-here">
    <h2 class="section-title reveal">// where_to_start</h2>
    <div class="start-grid">
      {
        startHere.map((card, i) => (
          <a
            class="start-card reveal"
            href={card.href}
            style={`--reveal-delay:${i * 90}ms`}
          >
            <span class="who">{card.icon} {card.who}</span>
            <p>{card.text}</p>
            <span class="cta-link">{card.cta} →</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="categories reveal">
    {
      Object.entries(CATEGORIES).map(([key, meta]) => (
        <a class="category-card" href={withBase(`/categories/${key}/`)}>
          <span class="icon">{meta.icon}</span>
          <span>
            <strong>{meta.name}</strong>
            <p>{meta.description}</p>
          </span>
        </a>
      ))
    }
  </section>

  <section>
    <h2 class="section-title reveal">// latest_posts</h2>
    <div class="grid">
      {
        posts.map((post, i) => (
          <div
            class="reveal"
            style={`--reveal-delay:${Math.min(i * 90, 450)}ms`}
          >
            <PostCard post={post} />
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  /* Full-bleed banner — stays dark in every theme */
  .hero-banner {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    min-height: 380px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(
        ellipse at center,
        rgb(0 255 65 / 6%) 0%,
        transparent 65%
      ),
      var(--hero-bg);
  }

  .scanlines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0px,
      transparent 3px,
      rgb(0 0 0 / 18%) 4px
    );
    mix-blend-mode: multiply;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 4rem 1.5rem;
    max-width: 760px;
  }

  .kicker {
    font-family: var(--font-mono);
    color: var(--matrix-green);
    font-size: 0.95rem;
    margin-bottom: 1.25rem;
    opacity: 0;
    animation: fade-in-up 0.7s ease forwards;
  }

  .caret {
    animation: caret-blink 1s step-end infinite;
  }

  .hero-content h1 {
    background: linear-gradient(120deg, #b4ffc6, #00ff41 55%, #0f9d31);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-bottom: 1rem;
    opacity: 0;
    animation:
      fade-in-up 0.7s ease 0.15s forwards,
      glow-pulse 4s ease-in-out 1s infinite;
  }

  .tagline {
    color: var(--hero-muted);
    font-size: 1.15rem;
    margin-bottom: 2rem;
    opacity: 0;
    animation: fade-in-up 0.7s ease 0.3s forwards;
  }

  .cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    opacity: 0;
    animation: fade-in-up 0.7s ease 0.45s forwards;
  }

  .link-alt {
    font-family: var(--font-mono);
    font-size: 0.95rem;
  }

  .stats-bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    max-width: 720px;
    margin: 2.5rem auto;
    text-align: center;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    border-right: 1px solid var(--border);
  }

  .stat:last-child {
    border-right: none;
  }

  .stat .value {
    font-family: var(--font-mono);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--accent);
  }

  .stat .label {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .start-here {
    margin-bottom: 4rem;
  }

  .start-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }

  .start-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.3rem 1.4rem;
    transition:
      border-color 0.3s ease,
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .start-card:hover {
    text-decoration: none;
    border-color: var(--accent);
    transform: translateY(-3px);
    box-shadow: 0 0 20px rgb(var(--accent-rgb) / 12%);
  }

  .who {
    font-weight: 700;
    font-size: 1.02rem;
  }

  .start-card p {
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.55;
    flex: 1;
  }

  .cta-link {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--accent-hover);
  }

  @media (max-width: 560px) {
    .stats-bar {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 1.5rem;
    }

    .stat:nth-child(2) {
      border-right: none;
    }
  }

  .categories {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
    margin: 3rem 0 4rem;
  }

  .category-card {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.2rem;
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease,
      transform 0.3s ease;
  }

  .category-card:hover {
    text-decoration: none;
    border-color: var(--accent);
    box-shadow: 0 0 20px rgb(var(--accent-rgb) / 12%);
    transform: translateY(-3px);
  }

  .category-card strong {
    font-size: 1.05rem;
  }

  .category-card p {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .icon {
    font-size: 1.5rem;
  }

  .section-title {
    font-size: 1.7rem;
    margin-bottom: 1.5rem;
    font-family: var(--font-mono);
    color: var(--accent);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.25rem;
  }

  .grid > .reveal {
    height: 100%;
  }
</style>

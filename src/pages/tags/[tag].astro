---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { withBase, slugify, collectTechnologies } from "../../utils";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return collectTechnologies(posts).map((tag) => ({
    params: { tag: tag.slug },
    props: {
      name: tag.name,
      count: tag.count,
      posts: posts.filter((post) =>
        (post.data.technologies ?? []).some(
          (tech) => slugify(tech) === tag.slug,
        ),
      ),
    },
  }));
}

const { name, count, posts } = Astro.props;

posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title={`${name} articles | Kaonix`}
  description={`Articles and tutorials about ${name}.`}
>
  <header class="page-header">
    <h1>🏷️ {name}</h1>
    <p>{count} {count === 1 ? "article" : "articles"} tagged with {name}</p>
  </header>
  <div class="grid">
    {
      posts.map((post) => <PostCard post={post} />)
    }
  </div>
  <p class="back">
    <a href={withBase("/tags/")}>← All tags</a>
  </p>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .page-header p {
    color: var(--text-muted);
    font-size: 1.1rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.25rem;
  }

  .back {
    text-align: center;
    margin-top: 2rem;
  }
</style>

---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TagCloud from "../../components/TagCloud.astro";
import { collectTechnologies, withBase } from "../../utils";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const tags = collectTechnologies(posts);
---

<BaseLayout title="Tags | Kaonix" description="Browse articles by technology.">
  <header class="page-header">
    <h1>🏷️ Tags</h1>
    <p>{tags.length} technologies across the blog — pick one to see what's built with it.</p>
  </header>
  <TagCloud {tags} />
  <p class="back"><a href={withBase("/blog/")}>← All articles</a></p>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .page-header p {
    color: var(--text-muted);
    font-size: 1.1rem;
  }

  .back {
    text-align: center;
    margin-top: 2rem;
  }
</style>

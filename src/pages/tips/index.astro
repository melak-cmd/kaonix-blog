---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { TIPS, getTipOfTheDay } from "../../data/tips";

const tipOfDay = getTipOfTheDay();
---

<BaseLayout
  title="Tips & Tricks | Kaonix"
  description="Quick, practical tips for developers: debugging, git, security, docker and more."
>
  <header class="page-header">
    <h1>// tips_of_the_trade</h1>
    <p class="intro">
      {TIPS.length} short, practical lessons — one new highlight every day.
    </p>
  </header>

  <article class="tip-hero reveal">
    <span class="badge badge-tutorials">💡 Tip of the day</span>
    <h2>{tipOfDay.icon} {tipOfDay.title}</h2>
    <p>{tipOfDay.text}</p>
  </article>

  <div class="grid">
    {
      TIPS.map((tip, i) => (
        <article
          class:list={["tip-card", "reveal", { today: tip === tipOfDay }]}
          style={`--reveal-delay:${Math.min(i * 80, 400)}ms`}
          id={`tip-${i + 1}`}
        >
          <div class="head">
            <span>{tip.icon} {tip.title}</span>
            <span class="tag">#{tip.tag}</span>
          </div>
          <p>{tip.text}</p>
        </article>
      ))
    }
  </div>

  <p class="back reveal">
    <a href="/">← Back home</a>
  </p>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .page-header h1 {
    font-family: var(--font-mono);
    color: var(--accent);
  }

  .intro {
    color: var(--text-muted);
    margin-top: 0.4rem;
  }

  .tip-hero {
    background:
      radial-gradient(
        ellipse at top left,
        rgb(var(--accent-rgb) / 8%),
        transparent 60%
      ),
      var(--bg-card);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: var(--radius);
    padding: 1.5rem 1.75rem;
    margin-bottom: 2rem;
    box-shadow: 0 0 24px rgb(var(--accent-rgb) / 8%);
  }

  .tip-hero h2 {
    font-size: 1.3rem;
    margin: 0.9rem 0 0.4rem;
  }

  .tip-hero p {
    color: var(--text-muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
  }

  .grid > .reveal {
    height: 100%;
  }

  .tip-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.15rem 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    transition:
      border-color 0.3s ease,
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .tip-card:hover,
  .tip-card.today {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 0 18px rgb(var(--accent-rgb) / 10%);
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 400;
    color: var(--accent-hover);
    white-space: nowrap;
  }

  .tip-card p {
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .back {
    margin-top: 2.5rem;
  }
</style>
